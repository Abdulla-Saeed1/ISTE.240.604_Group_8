<!-- Form used to add a new booking -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Booking</title>
</head>

<body>

<h2>Add New Booking</h2>

<form action="/bookings/add" method="post">

    <table style="border-collapse: collapse; border: 2px solid black;">

        <tr>
            <td>Booking ID</td>
            <td><input type="number" name="bookingId"></td>
        </tr>

        <tr>
            <td>User ID</td>
            <td><input type="number" name="userId"></td>
        </tr>

        <tr>
            <td>Session ID</td>
            <td><input type="number" name="sessionId"></td>
        </tr>

        <tr>
            <td>Booking Date</td>
            <td><input type="text" name="bookingDate"></td>
        </tr>

        <tr>
            <td>Status</td>
            <td><input type="text" name="status"></td>
        </tr>

    </table>

    <br>

    <button type="submit">Add Booking</button>

</form>

<br>

<a href="/">Back to Home</a>

</body>
</html>