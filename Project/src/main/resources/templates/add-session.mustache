<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Session</title>
</head>

<body>

<h2>Add New Fitness Session</h2>

<form action="/sessions/add" method="post">

    <table style="border-collapse: collapse; border: 2px solid black;">

        <tr>
            <td>Session ID</td>
            <td><input type="number" name="sessionId"></td>
        </tr>

        <tr>
            <td>Session Name</td>
            <td><input type="text" name="sessionName"></td>
        </tr>

        <tr>
            <td>Trainer ID</td>
            <td><input type="number" name="trainerId"></td>
        </tr>

        <tr>
            <td>Date</td>
            <td><input type="text" name="date"></td>
        </tr>

        <tr>
            <td>Time</td>
            <td><input type="text" name="time"></td>
        </tr>

        <tr>
            <td>Duration</td>
            <td><input type="number" name="duration"></td>
        </tr>

        <tr>
            <td>Capacity</td>
            <td><input type="number" name="capacity"></td>
        </tr>

        <tr>
            <td>Location</td>
            <td><input type="text" name="location"></td>
        </tr>

    </table>

    <br>

    <button type="submit">Add Session</button>

</form>

<br>

<a href="/">Back to Home</a>

</body>
</html>