<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bookings</title>
</head>

<body>

<h2>Bookings List</h2>

<table style="border-collapse: collapse; border: 2px solid black;">

    <tr>
        <th>Booking ID</th>
        <th>User ID</th>
        <th>Session ID</th>
        <th>Booking Date</th>
        <th>Status</th>
    </tr>

    {{#bookings}}
        <tr>
            <td>{{bookingId}}</td>
            <td>{{userId}}</td>
            <td>{{sessionId}}</td>
            <td>{{bookingDate}}</td>
            <td>{{status}}</td>
        </tr>
    {{/bookings}}

</table>

<br>

<a href="/">Back to Home</a>

</body>
</html>