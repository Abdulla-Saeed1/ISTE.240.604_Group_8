<!-- Displays a table containing all users -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Users</title>
</head>

<body>

<h2>Users List</h2>

<table style="border-collapse: collapse; border: 2px solid black;">
    <tr>
        <th>User ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Phone Number</th>
        <th>Membership Type</th>
    </tr>

    {{#users}}
        <tr>
            <td>{{userId}}</td>
            <td>{{name}}</td>
            <td>{{email}}</td>
            <td>{{phoneNumber}}</td>
            <td>{{membershipType}}</td>
        </tr>
    {{/users}}

</table>

<br>

<a href="/">Back to Home</a>

</body>
</html>